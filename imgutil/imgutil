def container_supported(oscategory):
    """Whether building from container images and generating a Containerfile
    support oscategory, for example el10 or ubuntu24.04"""
    match = re.match(r'^(el|ubuntu|suse)([0-9]+(\.[0-9]+)?)$', oscategory)
    return bool(match) and float(match.group(2)) >= container_minversions[match.group(1)]

def container_source(source):
    """Whether the build source is a container image rather than a
    distribution directory"""
    if os.path.isdir(source):
        return os.path.exists(os.path.join(source, 'oci-layout'))
    return os.path.isfile(source) or source.startswith(container_transports)

def get_sif_offset(sifname):
    """Return the offset of the squashfs root partition of the SIF file
    sifname, or None if it is not a SIF file"""
    with open(sifname, 'rb') as sifin:
        header = sifin.read(128)
        if header[32:41] != b'SIF_MAGIC':
            return None
        # descriptor count, offset and total size, little endian like the
        # rest of the format
        dtotal, doffset, dsize = struct.unpack('<qqq', header[88:112])
        if dtotal < 1 or dsize < dtotal * 25 or doffset + dsize > os.fstat(sifin.fileno()).st_size:
            raise Exception('{0} is not a valid SIF file'.format(sifname))
        for idx in range(dtotal):
            sifin.seek(doffset + idx * (dsize // dtotal))
            # data type, in use flag, three ids, then the data offset
            dtype, used, offset = struct.unpack('<i?12xq', sifin.read(25))
            if dtype != 0x4004 or not used:  # only partitions
                continue
            sifin.seek(offset)
            if sifin.read(4) == b'hsqs':
                return offset
    raise Exception('No squashfs partition found in {0}'.format(sifname))

def import_root(args):
    if args.containerfile:
        sys.stderr.write('--containerfile takes the OS from a distribution or the build system, '
                         'not from a container image\n')
        sys.exit(1)
    if args.addrepos:
        sys.stderr.write('A container image brings its own repositories, -r is not supported\n')
        sys.exit(1)
    if os.path.exists(args.scratchdir) and (not os.path.isdir(args.scratchdir) or os.listdir(args.scratchdir)):
        sys.stderr.write('{0} is not an empty directory\n'.format(args.scratchdir))
        sys.exit(1)
    try:
        _import_root(args)
    except BaseException:
        # kept for inspection, but a new build needs an empty directory
        if os.path.isdir(args.scratchdir) and os.listdir(args.scratchdir):
            sys.stderr.write('{0} holds what was imported so far, remove it before '
                             'building again\n'.format(args.scratchdir))
        raise

def _import_root(args):
    image = args.source
    sifoffset = None
    if os.path.isdir(image):
        image = 'oci:' + image
    elif os.path.isfile(image):
        try:
            sifoffset = get_sif_offset(image)
        except Exception as e:
            sys.stderr.write('{0}\n'.format(e))
            sys.exit(1)
        if sifoffset is None:
            # podman save writes Docker archives unless asked for OCI
            marker = None
            try:
                with tarfile.open(image) as tarin:
                    for member in tarin:
                        if os.path.normpath(member.name) in ('oci-layout', 'manifest.json'):
                            marker = os.path.normpath(member.name)
                            break
            except tarfile.TarError:
                pass
            if marker == 'oci-layout':
                image = 'oci-archive:' + image
            elif marker == 'manifest.json':
                image = 'docker-archive:' + image
            else:
                sys.stderr.write('{0} is not a SIF file or a container image archive\n'.format(image))
                sys.exit(1)
    if image != args.source and ':' in args.source:
        # podman would take what follows the colon for the image reference
        sys.stderr.write('podman cannot read {0}, as its path contains a colon\n'.format(args.source))
        sys.exit(1)
    if sifoffset is not None:
        if not shutil.which('unsquashfs'):
            sys.stderr.write('Importing a SIF file requires unsquashfs from squashfs-tools\n')
            sys.exit(1)
        if subprocess.call(['unsquashfs', '-f', '-o', str(sifoffset),
                            '-d', args.scratchdir, image]):
            sys.stderr.write('Unable to extract {0}\n'.format(image))
            sys.exit(1)
    elif not shutil.which('podman'):
        sys.stderr.write('Importing a container image requires podman\n')
        sys.exit(1)
    else:
        # podman pulls or loads the image as needed, so any of its transports
        # work. Other than a local image, it goes to a storage of its own,
        # removed afterwards, so it never replaces images and tags of the
        # system, for example with the variant of another architecture.
        podman = ['podman']
        tmpstorage = None
        if not image.startswith('containers-storage:'):
            mkdirp(os.path.dirname(args.scratchdir))
            tmpstorage = tempfile.mkdtemp(prefix='.imgutil-storage-', dir=os.path.dirname(args.scratchdir))
            # vfs leaves no mounts behind that would keep it from being removed
            podman += ['--root', os.path.join(tmpstorage, 'root'), '--runroot',
                       os.path.join(tmpstorage, 'run'), '--storage-driver', 'vfs']
        createcmd = podman + ['create']
        if args.arch:
            # the matching variant of an image for several architectures
            createcmd += ['--arch', deb_arch_map.get(uname_arch_map.get(args.arch, args.arch), args.arch)]
        try:
            try:
                cid = subprocess.check_output(createcmd + [image, '/bin/sh']).decode('utf8').strip()
            except subprocess.CalledProcessError:
                sys.exit(1)  # podman explained why
            mkdirp(args.scratchdir)
            try:
                try:
                    imageid = subprocess.check_output(
                        podman + ['container', 'inspect', '--format', '{{.Image}}', cid]).decode('utf8').strip()
                    imagearch = subprocess.check_output(
                        podman + ['image', 'inspect', '--format', '{{.Architecture}}', imageid]).decode('utf8').strip()
                except subprocess.CalledProcessError:
                    sys.exit(1)  # podman explained why
                imagearch = uname_arch_map.get(imagearch, imagearch)
                # before extracting what would be refused later, an image that
                # does not name its architecture is checked after extracting
                if args.arch and imagearch and uname_arch_map.get(args.arch, args.arch) != imagearch:
                    sys.stderr.write('Requested architecture {0} conflicts with source '
                                     'architecture {1}\n'.format(args.arch, imagearch))
                    sys.exit(1)
                export = subprocess.Popen(podman + ['export', cid], stdout=subprocess.PIPE)
                untar = subprocess.call(
                    ['tar', '-x', '-p', '--numeric-owner', '--xattrs', '--xattrs-include=*',
                     '-C', args.scratchdir, '-f', '-'], stdin=export.stdout)
                export.stdout.close()
                if export.wait() or untar:
                    sys.stderr.write('Unable to extract {0}\n'.format(image))
                    sys.exit(1)
            finally:
                # not check_call, it would hide why the extraction failed
                if subprocess.call(podman + ['rm', cid], stdout=subprocess.DEVNULL):
                    sys.stderr.write('Unable to remove container {0}\n'.format(cid))
        finally:
            if tmpstorage:
                shutil.rmtree(tmpstorage, ignore_errors=True)
    oshandler = fingerprint_host(args, args.scratchdir)
    if oshandler is None:
        sys.stderr.write('Unable to recognize the os of {0}\n'.format(args.source))
        sys.exit(1)
    if not container_supported(oshandler.oscategory):
        sys.stderr.write('Building from {0} container images is not supported\n'.format(oshandler.oscategory))
        sys.exit(1)
    if not os.path.exists(oshandler.pkglist):
        sys.stderr.write('No package list found for {0}\n'.format(oshandler.oscategory))
        sys.exit(1)
    # an image without merged /usr has bash only in /bin. Links are not
    # followed, an absolute one would resolve on this system
    for elfpath in ('usr/bin/bash', 'bin/bash'):
        elfpath = os.path.join(args.scratchdir, elfpath)
        if os.path.isfile(elfpath) and not os.path.islink(elfpath):
            break
    else:
        sys.stderr.write('No bash in {0} to detect its architecture from\n'.format(args.source))
        sys.exit(1)
    with open(elfpath, 'rb') as elfin:
        elfin.seek(18)
        imagearch = elf_arch_map.get(struct.unpack('<H', elfin.read(2))[0])
    if not imagearch:
        sys.stderr.write('The architecture of {0} is not supported, only {1}\n'.format(
            args.source, ' and '.join(elf_arch_map.values())))
        sys.exit(1)
    oshandler.set_arch(imagearch)
    # container base images mask units a booted node needs, for example
    # remounting the root filesystem read-write, and keep services from
    # starting on package updates
    for unit in ('console-getty.service', 'dev-hugepages.mount', 'getty.target',
                 'sys-fs-fuse-connections.mount', 'systemd-logind.service',
                 'systemd-remount-fs.service'):
        unitpath = os.path.join(args.scratchdir, 'etc/systemd/system', unit)
        if os.path.islink(unitpath) and os.readlink(unitpath) == '/dev/null':
            os.remove(unitpath)
            sys.stdout.write('Unmasked {0}, as masked by container images\n'.format(unit))
    policyrc = os.path.join(args.scratchdir, 'usr/sbin/policy-rc.d')
    if os.path.exists(policyrc):
        os.remove(policyrc)
        sys.stdout.write('Removed /usr/sbin/policy-rc.d, which keeps services from starting\n')
    sys.stdout.flush()  # before build_root forks, or the output repeats
    oshandler.imported = True
    build_root(args, oshandler)


def write_containerfile(args, oshandler):
    # A starting point for a CI built image that has every package build
    # checks for, generated from the same package list
    if os.path.isdir(args.scratchdir):
        sys.stderr.write('{0} is a directory, give the file to write or - for '
                         'standard output\n'.format(args.scratchdir))
        sys.exit(1)
    if oshandler.arch not in elf_arch_map.values():
        sys.stderr.write('Unsupported architecture {0}, use one of {1}\n'.format(
            oshandler.arch, ', '.join(elf_arch_map.values())))
        sys.exit(1)
    if not container_supported(oshandler.oscategory):
        sys.stderr.write('Generating a Containerfile for {0} is not supported\n'.format(oshandler.oscategory))
        sys.exit(1)
    if args.selinux and not oshandler.selinuxsupport:
        sys.stderr.write('--selinux is not supported for {0} images\n'.format(oshandler.oscategory))
        sys.exit(1)
    if not os.path.exists(oshandler.pkglist):
        sys.stderr.write('No package list found for {0}\n'.format(oshandler.oscategory))
        sys.exit(1)
    if oshandler.oscategory.startswith('el'):
        baseimage = 'docker.io/library/almalinux:{0}'.format(oshandler.oscategory[2:])
        # container bases ship coreutils-single, a build gets full coreutils
        install = ['dnf -y upgrade', 'dnf -y install --allowerasing coreutils {0}', 'dnf clean all']
        example = 'dnf -y install munge slurm-slurmd'
    elif oshandler.oscategory.startswith('ubuntu'):
        baseimage = 'docker.io/library/ubuntu:{0}'.format(oshandler.version)
        install = ['apt-get update', 'DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade',
                   'DEBIAN_FRONTEND=noninteractive apt-get -y install {0}', 'apt-get clean',
                   'rm -rf /var/lib/apt/lists/*']
        example = 'apt-get update && apt-get -y install munge slurmd'
    else:
        # Leap tags name the minor version
        version = oshandler.version if '.' in oshandler.version else oshandler.version + '.0'
        baseimage = 'registry.opensuse.org/opensuse/leap:{0}'.format(version)
        install = ['zypper -n update', 'zypper -n install {0}', 'zypper clean -a']
        example = 'zypper -n install munge slurm-node'
    oshandler.add_pkglists()
    pkgs = list(dict.fromkeys(oshandler.packages()))
    pkglines = [' '.join(pkgs[idx:idx + 8]) for idx in range(0, len(pkgs), 8)]
    pkgtext = '\\\n        ' + ' \\\n        '.join(pkglines)
    buildopts = ''
    if args.selinux:
        buildopts += ' --selinux'
    if args.packagelist:
        buildopts += ' -p {0}'.format(args.packagelist)
    for plist in args.addpackagelist:
        buildopts += ' -a {0}'.format(plist)
    platform = 'linux/' + deb_arch_map[oshandler.arch]
    lines = ['# Generated by imgutil build --containerfile for {0} {1}'.format(
                 oshandler.oscategory, oshandler.arch),
             '# It installs every package imgutil build checks for, so building from the',
             '# image does not run the package manager and needs no repositories.']
    if args.apptainer:
        lines += ['Bootstrap: docker', 'From: {0}'.format(args.base or baseimage), '', '%post']
        lines += ['    ' + cmd.format(pkgtext) for cmd in install]
        lines += ['    # Site specific content goes here, for example:',
                  '    # {0}'.format(example),
                  '',
                  '# Build the SIF, then the diskless root from it:',
                  '#   apptainer build --arch {0} myimage.sif myimage.def'.format(platform.split('/')[-1]),
                  '#   imgutil build{0} -s myimage.sif /var/lib/confluent/scratch/myimage'.format(buildopts)]
    else:
        lines += ['FROM --platform={0} {1}'.format(platform, args.base or baseimage),
                  'RUN ' + ' && \\\n    '.join(install).format(pkgtext),
                  '',
                  '# Site specific content goes here, for example:',
                  '# RUN {0}'.format(example),
                  '',
                  '# Build and save the image, then the diskless root from it:',
                  '#   podman build --platform {0} -t localhost/myimage .'.format(platform),
                  '#   podman save -o myimage.tar localhost/myimage',
                  '#   imgutil build{0} -s myimage.tar /var/lib/confluent/scratch/myimage'.format(buildopts)]
    text = ''.join(line + '\n' for line in lines)
    if args.scratchdir == '-':
        sys.stdout.write(text)
    else:
        with open(args.scratchdir, 'w') as outfile:
            outfile.write(text)

def prep_decrypt(indir):
    indir = os.path.abspath(indir)
    pubdir = os.path.dirname(indir)
    currtabs = subprocess.check_output(['dmsetup', 'table'])
    currtabs = currtabs.decode('utf8').split('\n')
    usednames = set([])
    for tab in currtabs:
        if ':' not in tab:
            continue
        tabname, _ = tab.split(':', 1)
        usednames.add(tabname)
    dmname = os.path.basename(tempfile.mktemp())
    while dmname in usednames:
        dmname = os.path.basename(tempfile.mktemp())
    privdir = pubdir.replace('public/os', 'private/os')
    privdir = os.path.join(privdir, 'pending')
    privdir = os.path.join(privdir, 'rootimg.key')
    with open(privdir, 'r') as keyfile:
        keyinfo = keyfile.read().split('\n', 2)
    cipher, key = keyinfo[:2]
    imglen = os.path.getsize(indir) - 4096
    if imglen % 512 != 0:
        raise Exception('Image is not correctly sized for encryption')
    imglen = imglen // 512
    loopdev = subprocess.check_output(['losetup', '-f'])
    loopdev = loopdev.decode('utf8')
    loopdev = loopdev.strip()
    subprocess.check_call(['losetup', '-r', loopdev, indir])
    tempfile.mktemp()
    subprocess.check_call(['dmsetup', 'create', dmname, '--table', '0 {0} crypt {1} {2} 0 {3} 8'.format(
        imglen, cipher, key, loopdev)])
    subprocess.check_call(['dmsetup', 'mknodes', dmname])
    return '/dev/mapper/{0}'.format(dmname), loopdev


def unpack_image(args):
    scratchdir = args.scratchdir
    indir = args.profilename
    if not os.path.exists(os.path.join(indir, 'rootimg.sfs')) and '/' not in indir:
        indir = os.path.join('/var/lib/confluent/public/os', indir)
    if os.path.isdir(indir):
        indir = os.path.join(indir, 'rootimg.sfs')
    cleandmtable = None
    loopdev = None
    prepped = False
    try:
        while not prepped:
            with open(indir, 'rb') as inpack:
                hdr = inpack.read(16)
                if hdr == b'\xaa\xd5\x0f\x7e\x5d\xfb\x4b\x7c\xa1\x2a\xf4\x0b\x6d\x94\xf7\xfc':
                    indir, loopdev = prep_decrypt(indir)
                    cleandmtable = os.path.basename(indir)
                    continue
                if hdr == b'\x63\x7b\x9d\x26\xb7\xfd\x48\x30\x89\xf9\x11\xcf\x18\xfd\xff\xa1':
                    raise Exception("Multi-partition squash image not supported")
                if hdr[:4] in (b'sqsh', b'hsqs'):
                    break
                raise Exception('Unrecognized image format')
        while scratchdir.endswith('/'):
            scratchdir = scratchdir[:-1]
        scratchdir = os.path.abspath(scratchdir)
        parentdir = os.path.dirname(scratchdir)
        targdir = os.path.basename(scratchdir)
        mkdirp(parentdir)
        os.chdir(parentdir)
        subprocess.check_call(['unsquashfs', '-d', targdir, indir])
    finally:
        if cleandmtable:
            mounted = True
            tries = 30
            time.sleep(0.1)
            while mounted and tries:
                tries -= 1
                try:
                    subprocess.check_call(['dmsetup', 'remove', cleandmtable])
                    mounted = False
                except subprocess.CalledProcessError:
                    time.sleep(0.1)
        if loopdev:
            subprocess.check_call(['losetup', '-d', loopdev])


def recursecp(source, targ):
    if os.path.islink(source):
        if os.path.exists(targ):
            return
        linktarg = os.readlink(source)
        os.symlink(linktarg, targ)
    if os.path.isdir(source):
        if not os.path.exists(targ):
            os.mkdir(targ)
        for entry in os.listdir(source):
            srcentry = os.path.join(source, entry)
            targentry = os.path.join(targ, entry)
            recursecp(srcentry, targentry)
    elif os.path.exists(targ):
        return
    else:
        shutil.copy2(source, targ)


def pack_image(args):
    outdir = args.profilename
    if '/' in outdir:
        raise Exception('Full path not supported, supply only the profile name\n')
    if args.baseprofile:
        baseprofiledir = args.baseprofile
        if '/' not in args.baseprofile:
            baseprofiledir = os.path.join('/var/lib/confluent/public/os', args.baseprofile)
        if not os.path.exists(baseprofiledir):
            sys.stderr.write('Specified base profile "{0}" does not seem to exist\n'.format(baseprofiledir))
            sys.exit(1)
    privdir = os.path.join('/var/lib/confluent/private/os/', outdir)
    outdir = os.path.join('/var/lib/confluent/public/os/', outdir)
    if os.path.exists(outdir):
        sys.stderr.write('Profile already exists, select a different name or delete existing {0}\n'.format(outdir))
        sys.exit(1)
    imginfofile = os.path.join(args.scratchdir, 'etc/confluentimg.buildinfo')
    distpath = None
    imgarch = None
    try:
        with open(imginfofile) as imginfoin:
            imginfo = imginfoin.read().split('\n')
            for lineinfo in imginfo:
                if lineinfo.startswith('BUILDSRC='):
                    distpath = lineinfo.replace('BUILDSRC=', '')
                elif lineinfo.startswith('ARCH='):
                    imgarch = lineinfo.replace('ARCH=', '')
    except IOError:
        pass
    kvermap = boot_kernels(args.scratchdir)
    if not kvermap:
        sys.stderr.write(
            'No kernel found in {0}\n'.format(
                os.path.join(args.scratchdir, 'boot')))
        sys.exit(1)
    mostrecent = newest_kernel(kvermap)
    newest = image_kernel(args.scratchdir)
    if newest != mostrecent:
        # modules built in exec or build were for that kernel
        sys.stderr.write('Warning: the newest kernel {0} is not in /boot, packing {1}\n'.format(
            newest, mostrecent))
    initrdname = os.path.join(args.scratchdir, 'boot/initramfs-{0}.img'.format(mostrecent))
    if not os.path.exists(initrdname):
        initrdname = os.path.join(args.scratchdir, 'boot/initrd-{0}'.format(mostrecent))
    if not os.path.exists(initrdname):
        initrdname = os.path.join(args.scratchdir, 'boot/initrd.img-{0}'.format(mostrecent))
    # Label with the policy of the image, which also covers changes made after
    # the build, e.g. with imgutil exec. mksquashfs keeps the labels.
    if not relabel_image(args.scratchdir):
        sys.exit(1)
    oum = os.umask(0o077)
    for path in ('/var/lib/confluent', '/var/lib/confluent/private', '/var/lib/confluent/private/os'):
        if not os.path.exists(path):
            mkdirp(path)
            subprocess.check_call(['chown', 'confluent', path])
    mkdirp(os.path.join(privdir, 'pending/'))
    os.umask(oum)
    mkdirp(os.path.join(outdir, 'boot/efi/boot'))
    mkdirp(os.path.join(outdir, 'boot/initramfs'))
    profname = os.path.basename(outdir)
    os.symlink(
        '/var/lib/confluent/public/site/initramfs.cpio',
        os.path.join(outdir, 'boot/initramfs/site.cpio'))
    shutil.copyfile(kvermap[mostrecent], os.path.join(outdir, 'boot/kernel'))
    shutil.copyfile(initrdname, os.path.join(outdir, 'boot/initramfs/distribution'))
    gather_bootloader(outdir, args.scratchdir)
    if args.unencrypted:
        tmploc = os.path.join(outdir, 'rootimg.sfs')
    else:
        tmploc = tempfile.mktemp()
    subprocess.check_call(['mksquashfs', args.scratchdir,
                           tmploc, '-comp', 'xz'])
    if not args.unencrypted:
        encrypt_image(tmploc, os.path.join(outdir, 'rootimg.sfs'), '{}/pending/rootimg.key'.format(privdir))
        os.remove(tmploc)
    with open(os.path.join(outdir, 'build-info'), 'w') as buildinfo:
        buildinfo.write('PACKEDFROM={}\nPACKDATE={}\n'.format(args.scratchdir, datetime.datetime.now().strftime('%Y-%m-%dT%H:%M')))
        if args.baseprofile:
            buildinfo.write('BASEPROFILE={}\n'.format(args.baseprofile))
    if args.baseprofile:
        if '/' not in args.baseprofile:
            args.baseprofile = os.path.join('/var/lib/confluent/public/os', args.baseprofile)
        recursecp(args.baseprofile, outdir)
        tryupdate = True
    else:
        if distpath:
            os.symlink(distpath, os.path.join(outdir, 'distribution'))
        oshandler = fingerprint_host(args, args.scratchdir)
        tryupdate = False
        if oshandler:
            prettyname = oshandler.osname
            with open(os.path.join(args.scratchdir, 'etc/os-release')) as osr:
                osrdata = osr.read().split('\n')
                for line in osrdata:
                    if line.startswith('PRETTY_NAME="'):
                        prettyname = line.replace(
                            'PRETTY_NAME=', '').replace('"', '')
            label = '{0} ({1})'.format(prettyname, 'Diskless Boot')
            with open(os.path.join(outdir, 'profile.yaml'), 'w') as profiley:
                profiley.write('label: {0}\nkernelargs: quiet # confluent_imagemethod=untethered|uncompressed|tethered # tethered is default when unspecified to save on memory, untethered will use more ram, but will not have any ongoing runtime root fs dependency on the http servers, uncompressed is like untethered, but trades even more ram for less cpu.\n'.format(label))
            oscat = oshandler.oscategory
            confdir = '/opt/confluent/lib/osdeploy/{}-diskless'.format(oscat)
            packarch = imgarch if imgarch else os.uname().machine
            archaddon = '/opt/confluent/lib/osdeploy/{}-diskless/initramfs/{}/addons.cpio'.format(oscat, packarch)
            addonlink = os.path.join(outdir, 'boot/initramfs/addons.cpio')
            if os.path.exists(archaddon):
                os.symlink(archaddon, addonlink)
            elif packarch == 'x86_64':
                # the unsuffixed addons path carries the x86_64 payload
                os.symlink('{}/initramfs/addons.cpio'.format(confdir),
                    addonlink)
            else:
                # addons of another architecture would contain foreign
                # binaries that break boot, so link to the (currently
                # missing) target arch path rather than falling back
                sys.stderr.write(
                    'Warning: {0} does not exist, the profile will not be '
                    'bootable until the confluent_osdeploy-{1} package is '
                    'installed\n'.format(archaddon, packarch))
                os.symlink(archaddon, addonlink)
            indir = '{}/profiles/default'.format(confdir)
            if os.path.exists(indir):
                copy_tree(indir, outdir)
                write_manifest(outdir, indir)
            tryupdate = True
    try:
        pwd.getpwnam('confluent')
        subprocess.check_call(['chown', '-R', 'confluent', outdir])
        subprocess.check_call(['chown', '-R', 'confluent', privdir])
        if tryupdate:
            subprocess.check_call(['osdeploy', 'updateboot', profname])
    except KeyError:
        pass

def gather_bootloader(outdir, rootpath='/'):
    shimdestfilename = 'BOOTX64.EFI'
    grubdestfilename = 'grubx64.efi'
    shimlocation = os.path.join(rootpath, 'boot/efi/EFI/BOOT/BOOTX64.EFI')
    if not os.path.exists(shimlocation):
        shimlocation = os.path.join(rootpath, 'boot/efi/EFI/BOOT/BOOTAA64.EFI')
        shimdestfilename = os.path.basename(shimlocation)
    if not os.path.exists(shimlocation):
        shimdestfilename = 'BOOTX64.EFI'
        shimlocation = os.path.join(rootpath, 'usr/lib64/efi/shim.efi')
    if not os.path.exists(shimlocation):
        shimlocation = os.path.join(rootpath, 'usr/lib/shim/shimx64.efi.signed.latest')
    if not os.path.exists(shimlocation):
        shimlocation = os.path.join(rootpath, 'usr/lib/shim/shimx64.efi.signed')
    if not os.path.exists(shimlocation):
        shimlocation = os.path.join(rootpath, 'usr/lib/shim/shimaa64.efi.signed.latest')
    if not os.path.exists(shimlocation):
        # SUSE 16 moved the efi payloads out of /usr/lib64/efi
        shimlocation = os.path.join(rootpath, 'usr/share/efi/x86_64/shim.efi')
        shimdestfilename = 'BOOTX64.EFI'
    if not os.path.exists(shimlocation):
        aa64shim = os.path.join(rootpath, 'usr/share/efi/aarch64/shim.efi')
        if os.path.exists(aa64shim):
            shimlocation = aa64shim
            shimdestfilename = 'BOOTAA64.EFI'
    mkdirp(os.path.join(outdir, 'boot/efi/boot'))
    shutil.copyfile(shimlocation, os.path.join(outdir, 'boot/efi/boot/{0}'.format(shimdestfilename)))
    for maybemokmanager in glob.glob(os.path.join(rootpath, 'boot/efi/EFI/*/mmx64.efi')):
        shutil.copyfile(maybemokmanager, os.path.join(outdir, 'boot/efi/boot/mmx64.efi'))
        break
    else:
        if os.path.exists(os.path.join(rootpath, 'usr/lib/shim/mmx64.efi')):
            shutil.copyfile(os.path.join(rootpath, 'usr/lib/shim/mmx64.efi'), os.path.join(outdir, 'boot/efi/boot/mmx64.efi'))
        elif os.path.exists(os.path.join(rootpath, 'usr/share/efi/x86_64/MokManager.efi')):
            shutil.copyfile(os.path.join(rootpath, 'usr/share/efi/x86_64/MokManager.efi'), os.path.join(outdir, 'boot/efi/boot/mmx64.efi'))
    for maybemokmanager in glob.glob(os.path.join(rootpath, 'boot/efi/EFI/*/mmaa64.efi')):
        shutil.copyfile(maybemokmanager, os.path.join(outdir, 'boot/efi/boot/mmaa64.efi'))
        break
    else:
        if os.path.exists(os.path.join(rootpath, 'usr/lib/shim/mmaa64.efi')):
            shutil.copyfile(os.path.join(rootpath, 'usr/lib/shim/mmaa64.efi'), os.path.join(outdir, 'boot/efi/boot/mmaa64.efi'))
    grubbin = None
    for candidate in glob.glob(os.path.join(rootpath, 'boot/efi/EFI/*')):
        if 'BOOT' not in candidate:
            grubbin = os.path.join(candidate, 'grubx64.efi')
            if os.path.exists(grubbin):
                break
            grubbin = os.path.join(candidate, 'grubaa64.efi')
            if os.path.exists(grubbin):
                grubdestfilename = os.path.basename(grubbin)
                break
    if not grubbin:
        grubbin = os.path.join(rootpath, 'usr/lib64/efi/grub.efi')
    if not os.path.exists(grubbin):
        grubbin = os.path.join(rootpath, 'usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed')
    if not os.path.exists(grubbin):
        grubbin = os.path.join(rootpath, 'usr/lib/grub/arm64-efi/monolithic/grubaa64.efi')
    if not os.path.exists(grubbin):
        grubbin = os.path.join(rootpath, 'usr/share/efi/x86_64/grub.efi')
    if not os.path.exists(grubbin):
        # same relocation as the shim above, on the other architecture
        aa64grub = os.path.join(rootpath, 'usr/share/efi/aarch64/grub.efi')
        if os.path.exists(aa64grub):
            grubbin = aa64grub
            grubdestfilename = 'grubaa64.efi'
    if not os.path.exists(grubbin):
        grubs = os.path.join(rootpath, 'boot/efi/EFI/*/grubx64.efi')
        grubs = glob.glob(grubs)
        if len(grubs) == 1:
            grubbin = grubs[0]
    if 'ubuntu' in grubbin:  # we needd to store a hint that this grub has a different hard coded prefix
        mkdirp(os.path.join(outdir, 'boot/EFI/ubuntu/'))
        with open(os.path.join(outdir, 'boot/EFI/ubuntu/grub.cfg'), 'w') as wo:
            wo.write('')
    shutil.copyfile(grubbin, os.path.join(outdir, 'boot/efi/boot/{0}'.format(grubdestfilename)))
    shutil.copyfile(grubbin, os.path.join(outdir, 'boot/efi/boot/grub.efi'))


