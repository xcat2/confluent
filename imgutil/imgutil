                os.symlink('/usr/lib/systemd/system/sshd.service', targfile)



class ElHandler(OsHandler):
    crossbuild = True
    pkgcaches = ('var/cache/dnf/*',)
    selinuxsupport = True

    def __init__(self, name, version, arch, args, hostpath='/'):
        self.oscategory = 'el{0}'.format(version.split('.')[0])
        if self.oscategory == 'el7':
            # el7-diskless labels nothing written at boot
            self.selinuxsupport = False
        self.yumargs = []
        super().__init__(name, version, arch, args)
        needpkgs = []
        if not hostpath:
            return
        if not os.path.exists(os.path.join(hostpath, 'usr/bin/tpm2_getcap')):
            needpkgs.append('tpm2-tools')
        lfuses = glob.glob(os.path.join(hostpath, '/usr/lib64/libfuse.so.2'))
        if not lfuses:
            needpkgs.append('fuse-libs')
        if (self.oscategory != 'el10' and
                not os.path.exists(os.path.join(hostpath, '/usr/bin/ipcalc'))):
            needpkgs.append('ipcalc')
        if (self.oscategory == 'el10' and
                not os.path.exists(os.path.join(hostpath, 'usr/sbin/dhcpcd'))):
            needpkgs.append('dhcpcd')
        elif (self.oscategory != 'el10' and
                not os.path.exists(os.path.join(hostpath, 'usr/sbin/dhclient'))):
            needpkgs.append('dhcp-client')
        if not os.path.exists(os.path.join(hostpath, 'usr/sbin/mount.nfs')):
            needpkgs.append('nfs-utils')
        # mksquashfs packs the image, the dracut module needs openssl
        if (not os.path.exists(os.path.join(hostpath, 'usr/sbin/mksquashfs')) and
                not os.path.exists(os.path.join(hostpath, 'usr/bin/mksquashfs'))):
            needpkgs.append('squashfs-tools')
        if not os.path.exists(os.path.join(hostpath, 'usr/bin/openssl')):
            needpkgs.append('openssl')
        if needpkgs:
            needapt = 'Missing packages needed in target for capture, to add required packages: dnf install ' + ' '.join(needpkgs)
            self.captureprereqs.append(needapt)

    def add_pkglists(self):
        self.yumargs.extend(self.list_packages())
        if self.selinux:
            # policycoreutils (setfiles), libselinux-utils (matchpathcon) and
            # python3 label files written at boot
            self.yumargs.extend(['selinux-policy-targeted', 'policycoreutils', 'libselinux-utils', 'python3'])

    def packages(self):
        # set_target puts the options before 'install', the packages follow
        if 'install' in self.yumargs:
            return self.yumargs[self.yumargs.index('install') + 1:]
        return self.yumargs

    def set_source(self, sourcepath):
        yumconfig = create_yumconf(sourcepath, self.addrepos)
        self.yumargs.extend(
            ['--setopt=reposdir={0}'.format(yumconfig), '--disablerepo=*',
             '--enablerepo=genimage-*'])
        if self.addrepos:
            self.yumargs.extend(['--enablerepo=addrepo-*'])
        self.sourcepath = sourcepath

    def set_target(self, targpath):
        self.targpath = targpath
        if not self.imported:
            self.yumargs.extend(
                ['--installroot={0}'.format(targpath),
                 '--releasever={0}'.format(self.version)])
            if self.arch != os.uname().machine:
                self.yumargs.append('--forcearch={0}'.format(self.arch))
        self.yumargs.append('install')

    def prep_root(self, args):
        mkdirp(os.path.join(self.targpath, 'usr/lib/dracut/modules.d'))
        mkdirp(os.path.join(self.targpath, 'etc/dracut.conf.d'))
        # an imported image may link it to a path that only resolves in the image
        resolv = os.path.join(self.targpath, 'etc/resolv.conf')
        if not os.path.lexists(resolv):
            open(resolv, 'w').close()
        mydir = get_mydir(self.oscategory)
        dracutdir = os.path.join(mydir, 'dracut')
        targdir = os.path.join(self.targpath, 'usr/lib/dracut/modules.d/97diskless')
        self.copy_to_target(dracutdir, targdir)
        with open(os.path.join(self.targpath, 'etc/dracut.conf.d/diskless.conf'), 'w') as dracutconf:
            dracutconf.write('compress=xz\nhostonly=no\ndracutmodules+=" diskless base terminfo "\n')
        cmd = ['chmod', 'a+x']
        cmd.extend(glob.glob(os.path.join(targdir, '*')))
        subprocess.check_call(cmd)
        yumcmd = ['yum'] if self._interactive else ['yum', '-y']
        if self.imported:
            initrds = self.snapshot_initrds('boot/initramfs-{0}.img')
            if not self.has_packages(args):
                args.cmd = yumcmd + self.yumargs
                if run_constrainedx(fancy_chroot, (args, self.targpath)):
                    raise Exception('Package installation failed')
            # a container build may also not have put the kernel in /boot
            for kver in self.stale_kernels(initrds, 'boot/initramfs-{0}.img'):
                modkernel = 'lib/modules/{0}/vmlinuz'.format(kver)
                if os.path.exists(os.path.join(self.targpath, modkernel)):
                    args.cmd = ['kernel-install', 'add', kver, '/' + modkernel]
                else:
                    # only /boot has the kernel, so only the initramfs is missing
                    args.cmd = ['dracut', '-f', '/boot/initramfs-{0}.img'.format(kver), kver]
                if run_constrainedx(fancy_chroot, (args, self.targpath)):
                    raise Exception('Installing kernel {0} failed'.format(kver))
        else:
            subprocess.check_call(yumcmd + self.yumargs)
        # boot entries written in the chroot carry the kernel command line of
        # the build system, and installing to disk writes its own entries
        for loadent in glob.glob(os.path.join(self.targpath, 'boot/loader/entries/*.conf')):
            os.remove(loadent)
        if self.selinux:
            # keep SELinux enabled, build_root labels the tree afterwards
            seconfigpath = os.path.join(self.targpath, 'etc/selinux/config')
            if os.path.exists(seconfigpath) and not get_selinux_policy(self.targpath):
                with open(seconfigpath) as seconfigin:
                    seconfig = seconfigin.read()
                if re.search(r'^SELINUX=', seconfig, re.M):
                    seconfig = re.sub(r'^SELINUX=.*$', 'SELINUX=enforcing', seconfig, flags=re.M)
                else:
                    seconfig += '\nSELINUX=enforcing\n'
                with open(seconfigpath, 'w') as seconfigout:
                    seconfigout.write(seconfig)
            if not get_selinux_policy(self.targpath):
                # not sys.exit, run_constrained would turn it into success
                sys.stderr.write('SELinux was requested, but the image has no /etc/selinux/config\n')
                raise Exception('SELinux not enabled in image')
            modfile = os.path.join(self.targpath, 'tmp/confluent_diskless.cil')
            with open(modfile, 'w') as modout:
                modout.write(SELINUX_DISKLESS_RULES)
            args.cmd = ['semodule', '-n', '-i', '/tmp/confluent_diskless.cil']
            rc = run_constrainedx(fancy_chroot, (args, self.targpath))
            os.remove(modfile)
            if rc:
                raise Exception('Installing the confluent SELinux module failed')
            return
        try:
            with open(os.path.join(self.targpath, 'etc/selinux/config'), 'r') as seconfigin:
                seconfig = seconfigin.read().replace('SELINUX=enforcing', 'SELINUX=disabled')
            with open(os.path.join(self.targpath, 'etc/selinux/config'), 'w') as seconfigout:
                seconfigout.write(seconfig)
        except Exception:  # this might not exist in all images
            pass
        with open('/proc/mounts') as mountinfo:
            for line in mountinfo.readlines():
                if line.startswith('selinuxfs '):
                    break
            else:
                try:
                    self.relabel_targdir()
                except subprocess.CalledProcessError:
                    # Some filesystem contexts can not accommodate the selinux labels, warn that
                    # this failed, but allow it to proceed in case it can boot anyway
                    sys.stderr.write('Warning: could not relabel target filesystem for SELinux\n')

    def relabel_targdir(self):
        # Prefer the policy of the image over the one of the build host
        policy = get_selinux_policy(self.targpath, enabledonly=False)
        try:
            if selinux_relabel(self.targpath, policy):
                return
        except (OSError, subprocess.CalledProcessError) as e:
            sys.stderr.write('Labeling with the image policy failed ({0}), using the host policy\n'.format(e))
        subprocess.check_call(
            ['setfiles', '-r', self.targpath,
             '/etc/selinux/targeted/contexts/files/file_contexts',
             self.targpath])


def get_selinux_policy(rootpath, enabledonly=True):
    """Return the SELINUXTYPE of the image at rootpath, or None if it has no
    SELinux config or, with enabledonly, if the config disables SELinux"""
    mode = None
    policy = 'targeted'
    try:
        with open(os.path.join(rootpath, 'etc/selinux/config')) as seconfig:
            for line in seconfig.read().split('\n'):
                line = line.split('#', 1)[0].strip()
                if line.startswith('SELINUX='):
                    # libselinux compares case insensitively
                    mode = line.split('=', 1)[1].strip().strip('"').lower()
                elif line.startswith('SELINUXTYPE='):
                    policy = line.split('=', 1)[1].strip().strip('"') or 'targeted'
    except IOError:
        return None
    if enabledonly and mode not in ('enforcing', 'permissive'):
        return None
    return policy


def selinux_relabel(rootpath, policy, force=False):
    """Label rootpath with its own policy, return False if it has none.
    force also resets user, role and range, not only the type"""
    if not policy:
        return False
    fcontexts = os.path.join(
        rootpath, 'etc/selinux', policy, 'contexts/files/file_contexts')
    if not os.path.exists(fcontexts):
        return False
    cmd = ['setfiles', '-r', rootpath]
    if force:
        cmd.append('-F')
    # Validate against the image policy rather than the one loaded on the
    # build host, which may be older and reject contexts of newer modules
    binpolicies = [x for x in glob.glob(os.path.join(
        glob.escape(rootpath), 'etc/selinux', policy, 'policy/policy.*'))
        if x.rsplit('.', 1)[-1].isdigit()]
    if binpolicies:
        cmd.extend(['-c', max(binpolicies, key=lambda x: int(x.rsplit('.', 1)[-1]))])
    subprocess.check_call(cmd + [fcontexts, rootpath])
    return True


def relabel_image(rootpath, force=False):
    """Label rootpath with its own policy if its config enables SELinux,
    return False if that was needed but could not be done"""
    policy = get_selinux_policy(rootpath)
    if not policy:
        return True
    try:
        if not selinux_relabel(rootpath, policy, force):
            sys.stderr.write('SELinux is enabled in {0}, but its {1} policy is missing\n'.format(rootpath, policy))
            return False
    except OSError as e:
        sys.stderr.write('SELinux labeling of {0} failed: {1}\n'.format(rootpath, e))
        return False
    except subprocess.CalledProcessError as e:
        # also when an enforcing build host refuses types its loaded policy lacks
        sys.stderr.write('SELinux labeling of {0} failed (setfiles exit code {1})\n'.format(rootpath, e.returncode))
        return False
    sys.stdout.write('Applied SELinux labels from the {0} policy of the image\n'.format(policy))
    return True


def versionize_string(key):
    """Analyzes string in a human way to enable natural sort

    :param nodename: The node name to analyze
    :returns: A structure that can be consumed by 'sorted'
    """
    versionlist = []
    patchlist = []
    addto = versionlist
    for part in re.split(numregex, key):
        if part in ('', '.'):
            continue
        if part == '-':
            addto = patchlist
            continue
        if not part.isdigit():
            break
        addto.append(int(part))
    return [versionlist, patchlist]



def version_sort(iterable):
    """Return a sort using natural sort if possible

    :param iterable:
    :return:
    """
    try:
        return sorted(iterable, key=versionize_string)
    except TypeError:
        # The natural sort attempt failed, fallback to ascii sort
        return sorted(iterable)


def get_kern_version(filename):
    with open(filename, 'rb') as kernfile:
        header = kernfile.read(2)
        if header == b'\x1f\x8b':
            # gzipped... we can't process this right now,
            # assume the filename has the version embedded
            return os.path.basename(filename).replace('vmlinuz-', '')
        if header == b'MZ':
            # PE format, no easy way to get version, assume filename has it
            return os.path.basename(filename).replace('vmlinuz-', '')                
        kernfile.seek(0x20e)
        offset = struct.unpack('<H', kernfile.read(2))[0] + 0x200
        kernfile.seek(offset)
        verinfo = kernfile.read(128)
        version, _ = verinfo.split(b' ', 1)
        if not isinstance(version, str):
            version = version.decode('utf8')
        return version


def mkdirp(path):
    try:
        os.makedirs(path)
    except OSError as e:
        if e.errno != 17:
            raise


def _exitcode_from_status(status):
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1


# uname() in the chroot reports the newest kernel of the image instead of the
# one of this system, so DKMS, kernel Makefiles and scriptlets build for the
# kernel the image boots. A seccomp filter hands each uname() to the process
# waiting for the chroot, which writes the answer into the caller.
class SeccompArch(enum.Enum):
    X86_64 = (0xc000003e, 63, 317, 313, 175)
    AARCH64 = (0xc00000b7, 160, 277, 273, 105)

    def __init__(
        self, arch, uname_syscall, seccomp_syscall,
        finit_module_syscall, init_module_syscall
    ):
        self.audit_arch = arch
        self.uname_syscall = uname_syscall
        self.seccomp_syscall = seccomp_syscall
        self.finit_module_syscall = finit_module_syscall
        self.init_module_syscall = init_module_syscall


SECCOMP_ARCH = {'x86_64': SeccompArch.X86_64, 'aarch64': SeccompArch.AARCH64}


class _IoVec(ctypes.Structure):
    _fields_ = [('base', ctypes.c_void_p), ('len', ctypes.c_size_t)]


class FakeUname(object):
    def __init__(self, installroot, release=None):
        self.installroot = os.path.abspath(installroot)
        self.fixed = release
        self.procdir = None
        self.fd = None
        self.current = None
        self.host = os.uname().release
        self.machine = os.uname().machine
        uts = ctypes.create_string_buffer(390)
        libc.uname(uts)
        self.uts = uts.raw
        with open('/proc/version') as versin:
            self.version = versin.read()

    @classmethod
    def for_args(cls, args):
        args.fakeuname = None
        if args.kernel != 'host':
            args.fakeuname = cls(args.scratchdir, args.kernel)
        return args.fakeuname

    def release(self):
        # no uname() here, the filter would have it wait for itself
        return self.fixed or image_kernel(self.installroot) or self.host

    def install(self):
        fd = -1
        if self.machine in SECCOMP_ARCH:
            seccomp_arch = SECCOMP_ARCH[self.machine]
            filt = (
                (0x20, 0, 0, 4),  # load arch
                (0x15, 1, 0, seccomp_arch.audit_arch),  # if arch mismatches, fall through to ALLOW
                (0x06, 0, 0, 0x7fff0000),  # allow all mismatched arch syscalls by this filter
                (0x20, 0, 0, 0),  # prepare to examine the system call number
                (0x15, 0, 1, seccomp_arch.uname_syscall),  # if it is not uname, skip next
                (0x06, 0, 0, 0x7fc00000),  # SECCOMP_RET_USER_NOTIF, it was uname
                (0x15, 1, 0, seccomp_arch.finit_module_syscall),  # if it is finit, then skip to blocking
                (0x15, 0, 1, seccomp_arch.init_module_syscall),  # If it is init_module, then fall into eperm, otherwise skip over to allow
                (0x06, 0, 0, 0x00050000 | errno.EPERM), # induce the call to do an EPERM error
                (0x06, 0, 0, 0x7fff0000))  # SECCOMP_RET_ALLOW
            fbuf = ctypes.create_string_buffer(
                b''.join(struct.pack('<HBBI', *insn) for insn in filt))
            prog = struct.pack('<HxxxxxxQ', len(filt), ctypes.addressof(fbuf))
            libc.syscall.restype = ctypes.c_long
            # SECCOMP_SET_MODE_FILTER with SECCOMP_FILTER_FLAG_NEW_LISTENER
            fd = libc.syscall(seccomp_arch.seccomp_syscall, 1, 8, ctypes.c_char_p(prog))
        if fd < 0:
            sys.stderr.write('Warning: unable to report the image kernel to uname, '
                             'the image sees the kernel of this system\n')
            return
        self.fd = fd
        # outside the image, so nothing in it can redirect the writes
        mkdirp('/run/imgutil')
        self.procdir = tempfile.mkdtemp(prefix='kernel-', dir='/run/imgutil')

    def mount_proc(self):
        if self.fd is None:
            return
        self.write_proc(self.release())
        _mount_file(os.path.join(self.procdir, 'osrelease'),
                    os.path.join(self.installroot, 'proc/sys/kernel/osrelease'))
        _mount_file(os.path.join(self.procdir, 'version'),
                    os.path.join(self.installroot, 'proc/version'))

    def write_proc(self, release):
        # rewritten in place, the bind mounts keep showing these files
        with open(os.path.join(self.procdir, 'osrelease'), 'w') as relout:
            relout.write(release + '\n')
        with open(os.path.join(self.procdir, 'version'), 'w') as versout:
            versout.write(self.version.replace(self.host, release, 1))
        self.current = release

    def answer(self):
        req = ctypes.create_string_buffer(80)
        if libc.ioctl(self.fd, 0xc0502100, req):  # SECCOMP_IOCTL_NOTIF_RECV
            return
        reqid, pid = struct.unpack_from('<QI', req.raw)
        addr = struct.unpack_from('<Q', req.raw, 32)[0]
        try:
            release = self.release()
            if release != self.current:
                # a kernel was installed since, show it in /proc too
                self.write_proc(release)
        except Exception as e:
            # the caller waits for an answer, so give one anyway
            sys.stderr.write('Warning: {0}\n'.format(e))
            release = self.current or self.host
        uts = self.uts[:130] + release.encode('utf8')[:64].ljust(65, b'\0') + self.uts[195:]
        src = ctypes.create_string_buffer(uts, len(uts))
        local = _IoVec(ctypes.addressof(src), len(uts))
        remote = _IoVec(addr, len(uts))
        # SECCOMP_IOCTL_NOTIF_ID_VALID (and its pre 5.7 number): the caller
        # still waits, so its pid was not reused
        reqidarg = ctypes.c_uint64(reqid)
        if all(libc.ioctl(self.fd, cmd, ctypes.byref(reqidarg)) for cmd in (0x40082102, 0x80082102)):
            return
        err = 0
        if libc.process_vm_writev(pid, ctypes.byref(local), 1, ctypes.byref(remote), 1, 0) != len(uts):
            err = -14  # EFAULT, as uname() itself would
        resp = struct.pack('<QqiI', reqid, 0, err, 0)
        libc.ioctl(self.fd, 0xc0182101, ctypes.c_char_p(resp))  # SECCOMP_IOCTL_NOTIF_SEND

    def wait(self, pid):
        # no threads after unshare(CLONE_NEWPID), so poll the listener and a
        # SIGCHLD wakeup pipe while waiting
        wakeup, wakeupw = os.pipe()
        os.set_blocking(wakeup, False)
        os.set_blocking(wakeupw, False)
        signal.signal(signal.SIGCHLD, lambda signum, frame: None)
        signal.set_wakeup_fd(wakeupw)
        poller = select.poll()
        poller.register(self.fd, select.POLLIN)
        poller.register(wakeup, select.POLLIN)
        try:
            while True:
                wpid, status = os.waitpid(pid, os.WNOHANG)
                if wpid:
                    return status
                for readyfd, _ in poller.poll():
                    if readyfd == self.fd:
                        self.answer()
                    else:
                        try:
                            os.read(wakeup, 512)
                        except BlockingIOError:
                            pass
        finally:
            shutil.rmtree(self.procdir, ignore_errors=True)


def run_constrainedx(function, args):
    # first fork to avoid changing namespace of unconstrained environment
    pid = os.fork()
    if pid:
        _, status = os.waitpid(pid, 0)
        return _exitcode_from_status(status)
    exitcode = 0
    try:
        libc.unshare(CLONE_NEWNS|CLONE_NEWPID)
        # must fork again due to CLONE_NEWPID, or else lose the ability to make
        # subprocesses
        pid = os.fork()
        if pid:
            _, status = os.waitpid(pid, 0)
            os._exit(_exitcode_from_status(status))
        # we are pid 1 now
        _mount('none', '/', flags=MS_REC|MS_PRIVATE)
        _mount('proc', '/proc', fstype='proc')
        function(*args)
    except Exception:
        exitcode = 1
    finally:
        os._exit(exitcode)

def run_constrained(function, args, fakeuname=None):
    # first fork to avoid changing namespace of unconstrained environment
    pid = os.fork()
    if pid:
        _, status = os.waitpid(pid, 0)
        return _exitcode_from_status(status)
    exitcode = 0
    try:
        libc.unshare(CLONE_NEWNS|CLONE_NEWPID)
        if fakeuname:
            # the chroot inherits the filter, this process answers it
            fakeuname.install()
        # must fork again due to CLONE_NEWPID, or else lose the ability to make
        # subprocesses
        pid = os.fork()
        if pid:
            if fakeuname and fakeuname.fd is not None:
                status = fakeuname.wait(pid)
            else:
                _, status = os.waitpid(pid, 0)
            os._exit(_exitcode_from_status(status))
        if fakeuname and fakeuname.fd is not None:
            # only the waiting process answers
            os.close(fakeuname.fd)
        # we are pid 1 now
        _mount('none', '/', flags=MS_REC|MS_PRIVATE)
        _mount('proc', '/proc', fstype='proc')
        function(args)
    except Exception as e:
        sys.stderr.write('{0}\n'.format(e))
        exitcode = 1
    finally:
        os._exit(exitcode)


def main():
    firstarg = sys.argv[1] if len(sys.argv) > 1 else None
    if firstarg == 'getfingerprint':
        print(fingerprint_host(None).get_json())
        return
    elif firstarg == 'capturelocal':
        capture_system()
        return
    elif firstarg == 'capturelocalboot':
        build_boot_tree('/run/imgutil/capout')
        return
    elif firstarg == 'capturelocalcleanup':
        capture_local_cleanup()
        return
    parser = argparse.ArgumentParser(description='Work with confluent OS cloning and diskless images')
    sps = parser.add_subparsers(dest='subcommand')
    buildp = sps.add_parser('build', help='Build a new diskless image from scratch')
    buildp.add_argument('-r', '--addrepos', help='Repositories to add in addition to the main source', default=[], action='append')
    buildp.add_argument('-p', '--packagelist', help='Filename of package list to replace default pkglist', default='')
