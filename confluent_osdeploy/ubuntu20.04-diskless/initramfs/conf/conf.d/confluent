if ! grep console= /proc/cmdline > /dev/null; then
    mkdir -p /custom-installation
    /opt/confluent/bin/autocons > /custom-installation/autocons.info
    cons=$(cat /custom-installation/autocons.info)
    if [ ! -z "$cons" ]; then
        echo "Auto-detected serial console: $cons" > ${cons%,*}
    fi
fi
echo . /scripts/init-premount/confluent >> /scripts/init-premount/ORDER
# Same as imageboot.sh, but for the lvm2 udev rules in this initramfs
if [ -e /etc/lvm/lvm.conf ] && ! grep -qs '^[[:space:]]*auto_activation_volume_list' /etc/lvm/lvm.conf /etc/lvm/lvmlocal.conf; then
    printf 'activation {\n\tauto_activation_volume_list = []\n}\n' >> /etc/lvm/lvmlocal.conf
fi
